---
/** Encart « Aucune donnée ne quitte l'iPhone » : titre et lignes avec cadenas. */
import Icon from './Icon.astro';

interface Props {
  title: string;
  items: readonly string[];
}
const { title, items } = Astro.props;
---

<div class="nodata">
  <p class="nodata__title">{title}</p>
  <ul>
    {items.map((item) => (
      <li>
        <Icon name="lock" size={20} />
        <span>{item}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .nodata {
    padding: 28px;
    background: var(--lr-surface);
    border: var(--border-heavy) solid var(--lr-ink);
    border-radius: 20px;
    box-shadow: 0 5px 0 var(--lr-ink);
  }
  .nodata__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lr-secondary);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    padding: 10px 0;
    border-bottom: var(--border-hair) solid var(--lr-surface-raised);
    font-weight: 700;
    font-size: 17px;
  }
  li:last-child {
    border-bottom: 0;
  }
</style>
