# Classic Punk — configuration Apache (hébergement Infomaniak)
# Copié tel quel dans dist/ au build, puis envoyé par le déploiement FTP.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Fichier d'état du déploiement FTP (liste des fichiers envoyés) : jamais servi.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS obligatoire (X-Forwarded-Proto : cas d'un proxy devant Apache).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://classic-punk.fr%{REQUEST_URI} [R=301,L]

  # www.classic-punk.fr → classic-punk.fr
  RewriteCond %{HTTP_HOST} ^www\.classic-punk\.fr$ [NC]
  RewriteRule ^ https://classic-punk.fr%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # CSP stricte : aucun script en ligne ni tiers. À élargir (connect-src, form-action)
  # quand le service d'envoi du formulaire de contact sera choisi.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS

  # Fichiers générés par Astro (nom avec empreinte) : cache long, jamais revalidé.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Polices et icônes (nom fixe) : cache d'un mois.
  <FilesMatch "\.(woff2|ico|svg|png)$">
    Header setifempty Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Pages HTML : toujours revalidées, pour voir un déploiement tout de suite.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
