---
/**
 * Bouton de téléchargement d'une app.
 * - status `available` : badge officiel Apple (SVG fourni par Apple, non modifié) vers `storeUrl`.
 * - sinon : bouton maison « Bientôt sur le (Mac) App Store », désactivé (aria-disabled).
 */
import Button from './Button.astro';
import { fr } from '../i18n/fr';

interface Props {
  status: 'dev' | 'coming-soon' | 'beta' | 'available';
  platform: 'macos' | 'ios';
  storeUrl?: string;
  size?: 'md' | 'lg';
  /** Sur fond sombre : version blanche du badge Apple (si elle est fournie). */
  onDark?: boolean;
  /** Ajoute la zone de protection Apple au-dessus du badge (sous un titre surligné, par exemple). */
  clearTop?: boolean;
}
const { status, platform, storeUrl, size = 'lg', onDark = false, clearTop = false } = Astro.props;

// Badges officiels Apple, version française, non modifiés (toolbox.marketingtools.apple.com),
// dans src/assets/brand/apple/ ; variante blanche facultative : <nom>-white.svg.
const BADGES = {
  macos: { file: 'mac-app-store-fr.svg', alt: 'Télécharger dans le Mac App Store' },
  ios: { file: 'app-store-fr.svg', alt: "Télécharger dans l'App Store" },
} as const;
const badgeFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/brand/apple/*.svg', { eager: true });

let badge: { src: string; width: number; height: number; alt: string } | undefined;
if (status === 'available') {
  const { file, alt } = BADGES[platform];
  const white = badgeFiles[`../assets/brand/apple/${file.replace('.svg', '-white.svg')}`];
  const mod = (onDark && white) || badgeFiles[`../assets/brand/apple/${file}`];
  if (!mod || !storeUrl) {
    throw new Error(
      `StoreButton : l'app est « available » mais il manque ${!storeUrl ? 'storeUrl' : `le badge officiel Apple src/assets/brand/apple/${file}`}.`,
    );
  }
  badge = { src: mod.default.src, width: mod.default.width, height: mod.default.height, alt };
}
// Hauteur d'affichage ; Apple demande au moins 40 px à l'écran.
const height = size === 'lg' ? 54 : 40;
---

{badge ? (
  <a class:list={['store-badge', clearTop && 'store-badge--clear']} href={storeUrl}>
    <img src={badge.src} alt={badge.alt} height={height} width={Math.round((badge.width * height) / badge.height)} />
  </a>
) : (
  <Button soon size={size} icon={platform === 'macos' ? 'mac' : 'iphone'}>
    {fr.storeSoon[platform]}
  </Button>
)}

<style>
  .store-badge {
    display: inline-block;
    line-height: 0;
  }
  /* Apple impose une zone de protection d'un quart de la hauteur du badge autour de celui-ci. */
  .store-badge--clear {
    margin-top: calc(var(--space-3) + 2px);
  }
</style>
