---
/** Gabarit commun : <head>, lien d'évitement, en-tête, pied de page. */
import '../styles/tokens.css';
import '../styles/components.css';
import '../styles/global.css';

import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { fr } from '../i18n/fr';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  /** Thème d'app posé sur le contenu (<main>), jamais sur l'en-tête ni le pied de page. */
  theme?: 'gig' | 'last-round';
}
const { title, description, ogImage, noindex, theme } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} ogImage={ogImage} noindex={noindex} />
    <link rel="preload" href="/fonts/Archivo-Condensed.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Archivo-Text.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f2f0ea" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body class="cp-root">
    <a class="skip-link" href="#main">{fr.skipLink}</a>
    <Header />
    <main id="main" tabindex="-1" data-theme={theme}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
